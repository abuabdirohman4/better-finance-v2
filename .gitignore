# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env

# drizzle migrations output
drizzle/

# playwright
/test-results
/playwright-report
/playwright/.cache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP configuration with secrets
.mcp.json
.mcp_config.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Migrate Files
docs/migrate*

# Issue tracking pindah ke hub ~/Documents/applications (satu beads untuk semua project).
# .beads di sini jangan dihidupkan lagi: pernah bikin DB corrupt saat checkout branch.
.beads/

# Izin Claude Code khusus mesin ini (berisi path absolut + nama MCP lokal).
